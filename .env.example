# Скопируйте в .env.local и заполните. Без этих переменных EduQuest работает
# в демо-режиме (прогресс в браузере, подготовленные объяснения учителя).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только для сервера! Никогда не добавляйте префикс NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI-учитель Луми (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
